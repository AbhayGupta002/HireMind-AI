# ============================================================
# TalentIQ / HireMind AI — Environment Configuration Example
# Copy this file to .env and configure your local values.
# .env is ignored by Git and will NEVER be committed.
# ============================================================

# Database Configuration
MYSQL_ROOT_PASSWORD=${MYSQL_ROOT_PASSWORD:-}
MYSQL_DATABASE=talentiq_dev
MYSQL_USER=talentiq_user
MYSQL_PASSWORD=${DB_PASSWORD:-}

DB_HOST=mysql
DB_PORT=3306
DB_NAME=talentiq_dev
DB_USER=talentiq_user
DB_PASSWORD=${DB_PASSWORD:-}

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & JWT
JWT_SECRET=talentiq-super-secret-key-change-in-production-must-be-at-least-256-bits
ADMIN_PASSWORD=Admin@123!

# Mail Server (Optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# OpenAI / AI Services (Optional)
OPENAI_API_KEY=
